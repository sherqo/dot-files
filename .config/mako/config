# Base settings
background-color=#202330
text-color=#FFF0F5
border-color=#FF4C7A
border-size=1
border-radius=5
padding=10
default-timeout=8000

# Format & Spacing
format=<b>%s</b>\n\n%b

# Urgency overrides
[urgency=low]
border-color=#565970
default-timeout=4000

[urgency=normal]
border-color=#FF4C7A
default-timeout=8000

[urgency=critical]
border-color=#FF7F9D
default-timeout=60000

# Window styling
font=CaskaydiaMono Nerd Font 10
width=300
height=100
margin=10
