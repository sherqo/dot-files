#!/bin/bash
CARD="alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
HEADSET="HiFi (HDMI1, HDMI2, HDMI3, Headphones, Headset, Mic1)"
SPEAKERS="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"

CURRENT=$(pactl list cards | grep "Active Profile:" | tail -1 | sed 's/.*Active Profile: //')

if [ "$CURRENT" = "$HEADSET" ]; then
    pactl set-card-profile "$CARD" "$SPEAKERS"
    notify-send -a "Audio" -e -i audio-speakers "Audio" "Switched to Speakers" -t 1500
else
    pactl set-card-profile "$CARD" "$HEADSET"
    notify-send -a "Audio" -e -i audio-headset "Audio" "Switched to Headset" -t 1500
fi
